    {
      "name": "Checks",
      "description": "Run manual checks and read check results.",
      "item": [
        {
          "name": "List site checks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/:site/checks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sites",
                ":site",
                "checks"
