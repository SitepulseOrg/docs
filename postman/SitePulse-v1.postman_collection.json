              ],
              "path": [
                "api",
                "v1",
                "sites",
                ":site",
                "checks"
              ],
              "variable": [
                {
                  "key": "site",
                  "value": "{{site_uuid}}",
                  "description": "Site UUID (from a create or list sites response)"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tools\": [\n    \"status\",\n    \"ssl\"\n  ],\n  \"automatic\": false\n}",
