                ":team",
                "sites"
              ],
              "variable": [
                {
                  "key": "team",
                  "value": "1",
                  "description": "Numeric team id (from the List teams response)"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\",\n  \"name\": \"Example\",\n  \"notes\": \"Production marketing site\",\n  \"js_rendered\": false,\n  \"monitoring_settings\": {\n    \"tools\": {\n      \"status\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 60,\n        \"settings\": {\n          \"header\": {\n            \"name\": null,\n            \"value\": null\n          },\n          \"failures_to_open\": 2,\n          \"successes_to_resolve\": 1,\n          \"confirmation_retry_minutes\": 2,\n          \"incident_follow_up_minutes\": 5\n        }\n      },\n      \"ssl\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"expiry_days\": 14\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a site. Only url is required; name is generated from the domain when omitted. Returns 201.\n\n**Required scope:** `sites:write`"
          },
          "response": []
        },
