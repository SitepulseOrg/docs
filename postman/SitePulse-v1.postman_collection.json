                {
                  "key": "automatic",
                  "value": "false",
                  "disabled": true,
                  "description": "true = automatic; false = manual"
                },
                {
                  "key": "run_reason",
                  "value": "scheduled",
                  "disabled": true,
                  "description": "scheduled, confirmation_retry, or incident_follow_up"
                },
                {
                  "key": "from",
                  "value": "",
                  "disabled": true,
                  "description": "created_at >= date (YYYY-MM-DD)"
                },
                {
                  "key": "to",
                  "value": "",
                  "disabled": true,
                  "description": "created_at <= date (must be >= from)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true,
                  "description": "Page number (>= 1)"
                },
                {
                  "key": "per_page",
                  "value": "25",
                  "disabled": true,
                  "description": "Results per page (max 100)"
                }
              ]
            },
            "description": "Paginated check history for a site.\n\n**Required scope:** `checks:read`"
          },
          "response": []
