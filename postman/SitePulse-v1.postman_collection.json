              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sites\": [\n    {\n      \"url\": \"https://example.com\",\n      \"name\": \"Marketing site\"\n    },\n    {\n      \"url\": \"https://blog.example.com\"\n    }\n  ]\n}",
