          },
          "response": []
        },
        {
          "name": "Get team monitoring defaults",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/teams/:team/monitoring",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "teams",
                ":team",
                "monitoring"
              ],
              "variable": [
                {
                  "key": "team",
                  "value": "1",
                  "description": "Numeric team id (from the List teams response)"
                }
              ]
            },
            "description": "Team-wide monitoring defaults: enabled tools, cadences, issue rules, quiet time, escalation, and UI preset metadata.\n\n**Required scope:** `teams:read`"
          },
          "response": []
        },
        {
          "name": "Update team monitoring defaults",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/teams/:team/monitoring",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "teams",
                ":team",
                "monitoring"
              ],
              "variable": [
                {
                  "key": "team",
                  "value": "1",
                  "description": "Numeric team id (from the List teams response)"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monitoring_settings\": {\n    \"tools\": {\n      \"status\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 60,\n        \"settings\": {\n          \"header\": {\n            \"name\": null,\n            \"value\": null\n          },\n          \"failures_to_open\": 2,\n          \"successes_to_resolve\": 1,\n          \"confirmation_retry_minutes\": 2,\n          \"incident_follow_up_minutes\": 5\n        }\n      },\n      \"ssl\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"expiry_days\": 14,\n          \"failures_to_open\": 1,\n          \"confirmation_retry_minutes\": 2\n        }\n      },\n      \"dns\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"hard_failures_only\": true,\n          \"monitored_record_types\": [\n            \"A\",\n            \"AAAA\",\n            \"CNAME\",\n            \"MX\",\n            \"NS\",\n            \"TXT\"\n          ]\n        }\n      },\n      \"broken-links\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"min_broken_count\": 5,\n          \"consecutive_breaches_to_open\": 1,\n          \"ignore_paths\": [\n            \"/wp-admin/*\"\n          ],\n          \"ignore_external_links\": true,\n          \"ignore_redirects\": true\n        }\n      },\n      \"performance\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"url\": null,\n          \"min_score\": 60,\n          \"max_response_time_ms\": 3000,\n          \"max_ttfb_ms\": 3000,\n          \"max_load_time_seconds\": 5,\n          \"consecutive_breaches_to_open\": 2\n        }\n      }\n    },\n    \"quiet_time\": {\n      \"enabled\": false,\n      \"starts_at\": \"22:00\",\n      \"ends_at\": \"07:00\"\n    },\n    \"escalation\": {\n      \"enabled\": true,\n      \"intervals\": [\n        60\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update team monitoring defaults. Send the full monitoring_settings object. Updating cadences resyncs automatic schedules for all team sites.\n\n**Required scope:** `teams:write`"
          },
          "response": []
        }
      ]
    },
    {
