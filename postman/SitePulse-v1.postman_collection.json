{
  "info": {
    "name": "SitePulse API v1",
    "description": "Public SitePulse v1 API. Set `auth_token` to a personal access token (Settings \u2192 API tokens) and leave `base_url` as the production host (or your self-hosted hostname). Every request inherits bearer auth from the collection. Replace `:team`, `:site`, `:check`, and `:issue` path variables in the Params tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://app.sitepulse.dev",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Me",
      "description": "The authenticated token owner.",
      "item": [
        {
          "name": "Get current user and teams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Returns the authenticated user and every team they belong to (with plan limits).\n\n**Required scope:** `teams:read`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Teams",
