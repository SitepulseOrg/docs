            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\",\n  \"name\": \"Example\",\n  \"notes\": \"Updated notes\",\n  \"pinned\": true,\n  \"js_rendered\": true,\n  \"monitoring_settings\": {\n    \"tools\": {\n      \"status\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 60,\n        \"settings\": {\n          \"failures_to_open\": 1,\n          \"successes_to_resolve\": 1\n        }\n      },\n      \"broken-links\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"ignore_paths\": [\n            \"/admin\",\n            \"/preview\"\n          ],\n          \"ignore_external_links\": true,\n          \"ignore_redirects\": false\n        }\n      },\n      \"dns\": {\n        \"enabled\": true,\n        \"cadence_minutes\": 1440,\n        \"settings\": {\n          \"hard_failures_only\": false,\n          \"expected_records\": {\n            \"A\": [\n              \"203.0.113.1\"\n            ]\n          },\n          \"monitored_record_types\": [\n            \"A\",\n            \"TXT\"\n          ]\n        }\n      }\n    },\n    \"snoozed_until\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update a site. url is required by the current validator. Updating enabled checks or cadences resyncs automatic schedules.\n\n**Required scope:** `sites:write`"
