{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sitepulse Docs",
  "description": "Documentation for Sitepulse. Set up uptime, SSL, DNS, broken-link, and performance monitoring, configure alerts, and use the API.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#b5a2fa",
    "dark": "#7C3AED"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "User Guide",
        "pages": [
          "guide/authentication",
          "guide/dashboard",
          "guide/sites",
          "guide/checks",
          "guide/monitoring",
          "guide/issues",
          "guide/notifications",
          "guide/team-management",
          "guide/billing"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/overview",
          "api/authentication",
          "api/requests-responses",
          "api/resources",
          "api/endpoints",
          "api/check-results"
        ]
      }
    ],
    "global": {

    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "http://sitepulse.dev/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.sitepulse.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
